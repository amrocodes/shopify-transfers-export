# Shopify
SHOPIFY_SHOP_DOMAIN=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=YOUR_ADMIN_API_TOKEN
SHOPIFY_API_VERSION=2025-10

# Date window (optional overrides; defaults to ±7 days around today)
# SHOPIFY_START_DATE=2025-10-20
# SHOPIFY_END_DATE=2025-11-03

# Google Sheets
GSPREAD_SHEET_ID=YOUR_SHEET_ID
GOOGLE_OAUTH_CLIENT_JSON=/absolute/path/to/client_secret.json
GOOGLE_OAUTH_TOKEN_PKL=/absolute/path/to/token.pkl
