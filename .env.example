# Shopify
SHOPIFY_SHOP_DOMAIN="yourshop.myshopify.com"
SHOPIFY_ACCESS_TOKEN="YOUR_ADMIN_API_TOKEN"
SHOPIFY_API_VERSION="2025-10"

# Date window (auto ±7 days if unset)
# SHOPIFY_START_DATE="2025-10-20"
# SHOPIFY_END_DATE="2025-11-03"

# Google Sheets (OAuth user flow)
GSPREAD_SHEET_ID="YOUR_GOOGLE_SHEET_ID"
GOOGLE_OAUTH_CLIENT_JSON="/absolute/path/to/your/oauth_client.json"  # not checked in
GOOGLE_OAUTH_TOKEN_PKL="/absolute/path/to/token.pkl"                 # not checked in

# Optional: per-transfer tabs upload throttling
GSPREAD_PER_TAB_DELAY="2.8"
GSPREAD_COOL_OFF_EVERY_N="10"
GSPREAD_COOL_OFF_SECONDS="8"

# Optional: prune old tabs
GSPREAD_PRUNE_TABS="1"
GSPREAD_TAB_PREFIX="#T"
EOF
