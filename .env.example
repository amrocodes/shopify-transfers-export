# Shopify
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=__PUT_YOUR_ADMIN_API_TOKEN_HERE__
SHOPIFY_API_VERSION=2025-10

# Date window (optional; script defaults to today±7 days if omitted)
# SHOPIFY_START_DATE=2025-10-20
# SHOPIFY_END_DATE=2025-11-03

# Google Sheets
GSPREAD_SHEET_ID=__PUT_GOOGLE_SHEET_ID_HERE__
GOOGLE_OAUTH_CLIENT_JSON=/absolute/path/to/client_secret.json
GOOGLE_OAUTH_TOKEN_PKL=/absolute/path/to/token.pkl
