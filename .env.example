# -------------------------
# Shopify API Configuration
# -------------------------

# Your Shopify store domain, without https://
# Example: yourstore.myshopify.com
SHOPIFY_SHOP_DOMAIN=

# Shopify Admin API access token (GraphQL)
# DO NOT PUT REAL TOKENS IN THIS FILE
SHOPIFY_ACCESS_TOKEN=

# Shopify Admin API version you want to use
# Example: 2025-01
SHOPIFY_API_VERSION=

# Optional: restrict transfers to a date range
TRANSFERS_START_DATE=
TRANSFERS_END_DATE=


# -------------------------
# Google Sheets API
# -------------------------

# Google Sheet ID where data will be written
# You can find this in the URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GSPREAD_SHEET_ID=

# Path to Google OAuth client JSON
# Example: /Users/you/Documents/google_oauth/client_secret.json
GOOGLE_OAUTH_CLIENT_JSON=

# Path to store your Google OAuth token file
GOOGLE_OAUTH_TOKEN_PKL=


# -------------------------
# Script Options
# -------------------------

# Set this to true if you want to archive stale tabs
ARCHIVE_OLD_TABS=false
